					"name": "Login as Super Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"const res = pm.response.json();",
									"pm.test(\"Login successful envelope\", function () {",
									"    pm.expect(res.success).to.be.true;",
									"    pm.expect(res.data.accessToken).to.be.a('string');",
									"});",
									"if (res.data && res.data.accessToken) {",
									"    pm.environment.set(\"accessToken\", res.data.accessToken);",
									"    console.log(\"Saved accessToken for Super Admin\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{superAdminEmail}}\",\n  \"password\": \"{{superAdminPassword}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
